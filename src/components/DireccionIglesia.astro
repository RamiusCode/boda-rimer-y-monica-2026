---
// DireccionSalon.astro (o el nombre que uses)
---
<section class="pt-16 md:pt-24 pb-2 px-4 relative">
  <div class="max-w-xl mx-auto text-center relative">

    <!-- 📅 PRIMER DÍA - HOJA DE CALENDARIO -->
    <div class="mb-10" id="primer-dia">
      <p class="font-charm text-2xl md:text-3xl text-[#C9A961] font-bold uppercase tracking-wide mb-4">
        Primer día
      </p>
      <div class="mx-auto w-28 md:w-32 rounded-xl overflow-hidden bg-white shadow-lg border border-[#C9A961]/30">
        <div class="bg-[#C9A961] py-1">
          <span class="font-charm text-sm md:text-base text-white font-bold uppercase tracking-widest">
            Sábado
          </span>
        </div>
        <div class="pt-2 pb-2">
          <span class="block font-charm text-5xl md:text-6xl text-[#626a54] font-bold leading-none">
            21
          </span>
          <span class="block font-charm text-xs md:text-sm text-[#C9A961] font-bold uppercase tracking-widest mt-2">
            Noviembre
          </span>
        </div>
      </div>
    </div>

    <!-- TÍTULO DIRECCIÓN -->
    <div class="mb-4" id="titulo-salon">
      <h2
        class="font-great-vibes text-4xl md:text-5xl text-[#C9A961]"
      >
        Ceremonia Religiosa
      </h2>
      <!-- 🌿 AVISO: ÁREA VERDE -->
      <span class="inline-block mt-2 px-3 py-0.5 rounded-full border border-[#626a54] font-charm text-sm md:text-base text-[#626a54]">
        En área verde
      </span>
    </div>

    <!-- 🏛️ ICONO DIRECCIÓN -->
    <div class="relative mb-4" id="icono-salon">

      <!-- 🌸 FLORES EN EL BORDE IZQUIERDO (PEGADA AL BORDE DEL CONTENEDOR) -->
      <div class="absolute left-0 top-1/2 -translate-y-1/2 w-12 pointer-events-none -ml-6 sm:-ml-7 md:-ml-8">
        <img
          src="/imagenes/FloresBorde.webp"
          alt="Flores decorativas izquierda"
          class="w-full h-auto object-contain"
        />
      </div>

      <!-- ICONO CENTRAL -->
      <div class="flex justify-center">
        <div class="marco-foto">
          <img
            src="/imagenes/ceremonia2.webp"
            alt="Lugar de la ceremonia religiosa"
            loading="lazy"
            class="block w-48 sm:w-56 md:w-64 h-auto"
          />
        </div>
      </div>

      <!-- 🌸 FLORES EN EL BORDE DERECHO (PEGADA AL BORDE DEL CONTENEDOR) -->
      <div class="absolute right-0 top-1/2 -translate-y-1/2 w-12 pointer-events-none -mr-6 sm:-mr-7 md:-mr-8">
        <img
          src="/imagenes/FloresBorde.webp"
          alt="Flores decorativas derecha"
          class="w-full h-auto object-contain scale-x-[-1]"
        />
      </div>

    </div>

    <!-- INFORMACIÓN DE UBICACIÓN -->
    <div class="mb-2" id="info-salon">
      <p
        class="font-charm text-xl md:text-lg text-[#626a54] leading-relaxed mb-2"
      >
        <b class="text-[#C9A961] text-2xl md:text-3xl">Centro Turístico “Los Wirkis”</b><br />
        Zona El Paso<br />
        <span class="text-[#626a54] font-bold text-xl md:text-2xl">12:00 a 12:30 P.M.</span>
      </p>
    </div>
    
    <!-- BOTÓN VER UBICACIÓN -->
    <div class="flex justify-center" id="boton-salon">
      
    <a
        href="https://maps.app.goo.gl/CvAvZrFHdryB8WyK6"
        target="_blank"
        rel="noopener noreferrer"
    >
        <img
        src="/imagenes/VerUbicacion.webp"
        alt="Ver ubicación en el mapa"
        class="w-56 md:w-56 lg:w-64 h-auto object-contain cursor-pointer transition-transform duration-300 hover:scale-105"
        />
    </a>
    </div>

  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { entrada } from "../scripts/entrada";

  document.addEventListener("DOMContentLoaded", () => {
    entrada({
      trigger: "#primer-dia",
      pasos: [["#primer-dia", "arriba"]],
    });
  });
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  
  gsap.registerPlugin(ScrollTrigger);

  if (typeof window !== "undefined") {
    document.addEventListener("DOMContentLoaded", () => {
      // Estado inicial
      gsap.set("#icono-salon", { opacity: 0, scale: 0.8 });
      gsap.set("#titulo-salon", { opacity: 0, scale: 0.9 });
      gsap.set("#info-salon", { opacity: 0, scale: 0.9 });
      gsap.set("#boton-salon", { opacity: 0, scale: 0.9 });

      // ✨ ANIMACIÓN SIMULTÁNEA - TODO AL MISMO TIEMPO
      ScrollTrigger.create({
        trigger: "#icono-salon",
        start: "top 85%",
        end: "top 20%",
        onEnter: () => {
          const tl = gsap.timeline();
          
          // TODO aparece al mismo tiempo
          tl.to("#icono-salon, #titulo-salon, #info-salon, #boton-salon", {
            opacity: 1,
            duration: 1,
            ease: "power2.out",
          })
          // Animaciones individuales (simultáneas)
          .to("#icono-salon", {
            scale: 1,
            duration: 1,
            ease: "back.out(1.5)",
          }, "<")
          .to("#titulo-salon, #info-salon, #boton-salon", {
            scale: 1,
            duration: 1,
            ease: "back.out(1.2)",
          }, "<");
        },
        onLeaveBack: () => {
          // Salida simultánea
          const tl = gsap.timeline();
          
          tl.to("#icono-salon, #titulo-salon, #info-salon, #boton-salon", {
            opacity: 0,
            duration: 0.5,
            ease: "power2.in",
          })
          .to("#icono-salon", {
            scale: 0.8,
            duration: 0.5,
            ease: "power2.in",
          }, "<")
          .to("#titulo-salon, #info-salon, #boton-salon", {
            scale: 0.9,
            duration: 0.5,
            ease: "power2.in",
          }, "<");
        },
      });

      console.log("🎉 Sección de Salón inicializada");
    });
  }
</script>

<style>
  /* Foto del lugar: filete dorado fino, borde blanco y doble línea exterior suave */
  .marco-foto {
    padding: 4px;
    background: #fff;
    border: 1px solid rgba(201, 169, 97, 0.7);
    border-radius: 0.75rem;
    outline: 1px solid rgba(201, 169, 97, 0.35);
    outline-offset: 4px;
    box-shadow: 0 8px 20px rgba(98, 106, 84, 0.15);
  }

  .marco-foto img {
    border-radius: 0.5rem;
  }
</style>