<!-- Scripts sin cambios -->
<script>
  import { gsap } from "gsap";
  import { entrada } from "../scripts/entrada";

  if (typeof window !== 'undefined') {
    document.addEventListener("DOMContentLoaded", () => {
      console.log("📅 Iniciando animaciones del calendario...");

      entrada({
        trigger: "#calendario-card",
        pasos: [
          ["#calendario-card", "abajo"],
          ["#hojas-cal-izq", "izq", { opacidad: 0.6 }],
          ["#hojas-cal-der", "der", { opacidad: 0.6 }],
          ["#linea-izq", "izq"],
          ["#titulo-mes-container h3", "centro"],
          ["#linea-der", "der"],
          [".dia-calendario", "centro", { stagger: 0.015 }],
        ],
      });

      gsap.to("#hojas-cal-izq", {
        y: -8,
        rotation: -3,
        duration: 3,
        ease: "sine.inOut",
        yoyo: true,
        repeat: -1,
        delay: 1,
      });

      gsap.to("#hojas-cal-der", {
        y: -8,
        rotation: 3,
        duration: 3,
        ease: "sine.inOut",
        yoyo: true,
        repeat: -1,
        delay: 1.2,
      });

      gsap.to(".dia-especial", {
        scale: 1.05,
        duration: 2.5,
        ease: "sine.inOut",
        yoyo: true,
        repeat: -1,
        delay: 1.5,
      });

      console.log("📅✨ ¡Calendario listo!");
    });
  }
</script>

<style>
  .dia-especial {
    box-shadow: 0 6px 20px rgba(201, 169, 97, 0.6);
    position: relative;
  }

  .dia-especial::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 0.5rem;
    border: 2px solid rgba(255, 255, 255, 0.3);
    pointer-events: none;
  }

  .dia-calendario:hover {
    transform: translateY(-2px);
  }
</style>